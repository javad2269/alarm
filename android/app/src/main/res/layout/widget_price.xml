<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#CC151b2a"
    android:padding="12dp"
    android:gravity="center"
    android:layoutDirection="rtl">

    <TextView android:id="@+id/w_title"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="💰 قیمت لحظه‌ای" android:textColor="#a78bfa"
        android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>

    <TextView android:id="@+id/w_usd"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="💵 دلار: -" android:textColor="#ffffff" android:textSize="14sp"/>

    <TextView android:id="@+id/w_ounce"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🌍 طلا: -" android:textColor="#ffffff" android:textSize="14sp"/>

    <TextView android:id="@+id/w_coin"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🏅 سکه: -" android:textColor="#ffffff" android:textSize="14sp"/>
</LinearLayout>
